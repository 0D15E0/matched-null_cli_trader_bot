# __TRADER_USER__ is a placeholder: substitute the account that owns the repo
# before installing (see deploy/pi/README.md, "The host").
[Unit]
Description=cli_trader book health check
After=network-online.target

[Service]
Type=oneshot
User=__TRADER_USER__
WorkingDirectory=/home/__TRADER_USER__/trader/cli_trader
ExecStart=/usr/bin/python3 /home/__TRADER_USER__/trader/cli_trader/scripts/check_pi.py
StandardOutput=append:/home/__TRADER_USER__/trader/cli_trader/logs_pi/healthcheck.log
StandardError=append:/home/__TRADER_USER__/trader/cli_trader/logs_pi/healthcheck.log
