# Runtime configuration for every cli_trader sleeve on this host.
# Changing a value here and restarting the units changes ALL sleeves at once,
# which is the point: the eight sleeves must never disagree about mode or size.
#
# MODE=paper -> simulated fills, no API keys touched, safe to run alongside
#                any other book. This is where a new host starts.
# MODE=live   -> real orders against the Poloniex account in .env.
#
# NEVER run MODE=live here while the Mac's launchd book is also live: two
# books on one account each see coins the other bought, and both halt on
# halted-balance-mismatch (or worse, double-trade). Migration order is:
# verify paper here -> stop the Mac book -> switch this to live.
MODE=live
STATE_DIR=state_live
EQUITY=487
QUOTE_CAP=487
# Sizing. Chosen 2026-08-25 from the ladder in PROFITABILITY_PLAN.md addendum 13:
# Sharpe is flat 0.20-0.40 so the target is a risk preference; the 90-bar
# window is a measured drawdown reducer over the 30-bar default (5 days of
# 4h bars is a noisy vol estimate). Applies at each sleeve's NEXT entry.
VOL_TARGET=0.30
VOL_WINDOW=90
POLL_INTERVAL=120
STRATEGY=ensemble_vote
PERIOD=14400

# Extra flags appended to every sleeve. Normally EMPTY.
#
# --adopt-venue-position tells a sleeve to take ownership of whatever base
# currency the account holds, instead of halting when the venue holds more than
# the bot bought. It DISABLES the guard that stops this bot selling coins it
# did not buy, so it is meant to be switched on for one cycle and switched off
# again -- never left on. Used 2026-08-26 to hand the bot the holdings that
# arrived from the Earn account.
EXTRA_FLAGS=--sparams enterVotes=2,exitVotes=0

# Momentary switch - see cli-trader@.service. Normally empty.
ADOPT=
