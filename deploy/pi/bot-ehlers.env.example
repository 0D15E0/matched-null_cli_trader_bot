# TEMPLATE for a second, PAPER-ONLY book running the ehlers_trend candidate
# alongside the live book, so both are observed over the identical window.
#
# Copy to deploy/pi/bot-ehlers.env ON THE HOST and fill in the values there.
# That copy is gitignored and must never be committed: this repository is
# public and the real file states the book's size.
#
# MODE must stay paper. The candidate's honest walk-forward edge is about
# +0.10 Sharpe, well inside one standard error, and the live book is itself a
# registered forward test that a configuration change would void. The unit
# refuses to start if MODE is anything but paper.
MODE=paper
STATE_DIR=<a state directory that is NOT state_live>

# Sizing MUST mirror the live book exactly, or the comparison measures sizing
# instead of the trading rule. Copy the values from deploy/pi/bot.env.
EQUITY=<same as the live book>
QUOTE_CAP=<same as the live book>
VOL_TARGET=<same as the live book>
VOL_WINDOW=<same as the live book>
POLL_INTERVAL=<same as the live book>
PERIOD=14400

STRATEGY=ehlers_trend
# The candidate exactly as the research loop found it. Do not "improve" these:
# the walk-forward-converged variant (cutoffPeriod=14, entrySigmas=0.5,
# slopeLag=1, volWindow=120) looked better on the four coins it was fitted to
# and then lost on 10 of 11 wider-universe rungs and on this very book. The
# forward-test registration names these values; any change is a new
# registration.
EXTRA_FLAGS=--sparams cutoffPeriod=10,entrySigmas=0.9,slopeLag=2,volWindow=30

ADOPT=
