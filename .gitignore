# Any runtime config or state, whatever it is named. The deployed values live
# only on the host that runs them; the repository carries *.example templates.
*.env
!*.env.example
deploy/pi/*.env
!deploy/pi/*.env.example
state_*/
logs_*/
*.sqlite3
*.sqlite3-*
*.lock
